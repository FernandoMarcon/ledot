#!/usr/bin/env bash

RASI="$HOME/.config/rofi/powermenu.rasi"
CNFR="$HOME/.config/rofi/confirm.rasi"

prompt="`hostname`"
mesg="Uptime : `uptime -p | sed -e 's/up //g'`"

option_1=" Lock"
option_2=" Logout"
option_3=" Suspend"
option_4=" Reboot"
option_5=" Shutdown"

yes=' Yes'
no=' No'

rofi_cmd() {
    rofi -dmenu \
        -p "$prompt" \
        -mesg "$mesg" \
        -theme ${RASI}
}

run_rofi() {
    echo -e "$option_1\n$option_2\n$option_3\n$option_4\n$option_5" | rofi_cmd
}

confirm_cmd() {
    rofi -dmenu \
        -p 'Confirmation' \
        -mesg 'Are you sure?' \
        -selected-row 1 \
        -no-click-to-exit \
        -theme ${CNFR}
}

confirm_exit() {
    echo -e "$yes\n$no" | confirm_cmd
}

confirm_run() {
    selected="$(confirm_exit)"
    if [[ "$selected" == "$yes" ]]; then
        ${1} && ${2:-true} && ${3:-true}
    fi
}

run_cmd() {
    if [[ "$1" == '--opt1' ]]; then
        ~/.config/i3/lock.sh
    elif [[ "$1" == '--opt2' ]]; then
        confirm_run 'i3-msg exit'
    elif [[ "$1" == '--opt3' ]]; then
        confirm_run 'systemctl suspend'
    elif [[ "$1" == '--opt4' ]]; then
        confirm_run 'systemctl reboot'
    elif [[ "$1" == '--opt5' ]]; then
        confirm_run 'systemctl poweroff'
    fi
}

chosen="$(run_rofi)"
case ${chosen} in
    $option_1) run_cmd --opt1 ;;
    $option_2) run_cmd --opt2 ;;
    $option_3) run_cmd --opt3 ;;
    $option_4) run_cmd --opt4 ;;
    $option_5) run_cmd --opt5 ;;
esac
